# Copy to .env and replace BOTH username placeholders with your own values.
# Actual .env files are private and excluded from Git and release packages.
WSL_DISTRO=Ubuntu
WSL_USER=your-linux-username
DOWNLOAD_DIR=/home/your-linux-username/Downloads/music
# Use an absolute Linux path. Quotes are optional, including for paths with spaces.
# Values are literal: no ~, $HOME, shell commands, or variable interpolation.
